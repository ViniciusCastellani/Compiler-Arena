{
  "source": "robot Beta {\n    const int POTENCIA = 2;\n    while (energy > 0) {\n        scan();\n        if (enemy.visible && enemy.distance < 450.0) {\n            rotate(enemy.direction);\n            fire(POTENCIA);\n        } else {\n            move(15);\n            rotate(20);\n        }\n    }\n}\n",
