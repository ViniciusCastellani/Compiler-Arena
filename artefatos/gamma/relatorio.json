{
  "source": "robot Gamma {\n    // Atira e foge quando o sensor hit indica que foi atingido.\n    while (hp > 0) {\n        scan();\n        if (enemy.visible) {\n            rotate(enemy.direction);\n            if (energy >= 4) { fire(2); }\n        }\n        if (hit) {\n            rotate(90);\n            move(80);\n        }\n    }\n}\n",
