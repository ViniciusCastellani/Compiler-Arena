{
  "source": "robot Alpha {\n    // O mesmo exemplo percorre as etapas nos slides.\n    int distancia = 10 + 20;\n    move(distancia + 0);\n    while (energy > 0) {\n        scan();\n        if (enemy.visible) {\n            rotate(enemy.direction);\n            fire(3);\n        } else {\n            rotate(15);\n        }\n    }\n}\n",
