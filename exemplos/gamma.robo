robot Gamma {
    // Atira e foge quando o sensor hit indica que foi atingido.
    while (hp > 0) {
        scan();
        if (enemy.visible) {
            rotate(enemy.direction);
            if (energy >= 4) { fire(2); }
        }
        if (hit) {
            rotate(90);
            move(80);
        }
    }
}
